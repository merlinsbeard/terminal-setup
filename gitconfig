[user]
	email = me@benpaat.xyz
	name = ben

# Large file storage support
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[core]
	# Use neovim as the default editor for commits, rebases, etc.
	editor = /opt/homebrew/bin/nvim

[init]
	# New repos start with 'main' instead of 'master'
	defaultBranch = main

[branch]
	# Show most recently committed branches first
	sort = -committerdate

[tag]
	# Sort tags by semantic version (v1.2.3) instead of alphabetically
	sort = version:refname

[diff]
	# Better diff algorithm that handles refactored code well
	algorithm = histogram
	# Highlight moved lines in a different color
	colorMoved = plain
	# Show 'i/' and 'w/' instead of 'a/' and 'b/' in diff headers (index/worktree)
	mnemonicPrefix = true
	# Detect renamed files in diffs
	renames = true

[help]
	# Prompt before auto-correcting typos (e.g. 'git stauts' -> 'git status')
	autocorrect = prompt

[commit]
	# Show the full diff in the commit message editor
	verbose = true

[pull]
	# Rebase local commits on top of upstream instead of creating merge commits
	rebase = true

[column]
	# Display branch lists and tags in columns
	ui = auto

[push]
	# Push current branch to a remote branch with the same name
	default = current
